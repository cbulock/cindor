{
  "name": "cindor-ui-core",
  "version": "0.1.74",
  "description": "Framework-agnostic Cindor web components built on standard custom elements.",
  "type": "module",
  "customElements": "./custom-elements.json",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/design",
    "src/styles.css",
    "custom-elements.json",
    "component-docs.json"
  ],
  "sideEffects": [
    "./src/register.ts",
    "./src/styles.css",
    "./dist/register.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cbulock/cindor",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/cbulock/cindor#readme",
  "bugs": {
    "url": "https://github.com/cbulock/cindor/issues"
  },
  "keywords": [
    "cindor",
    "web-components",
    "custom-elements",
    "lit",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./src/styles.css",
    "./custom-elements.json": "./custom-elements.json",
    "./component-docs.json": "./component-docs.json"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "highlight.js": "^11.11.1",
    "lit": "^3.2.1",
    "lucide": "^1.11.0"
  }
}
